# newapi-tools 服务地址（提供 /api/logs 查询接口）
NEWAPI_TOOLS_URL=http://localhost:8081

# PostgreSQL 连接参数（推荐方式，各参数独立配置）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=export123456
POSTGRES_DB=export_service
POSTGRES_SSLMODE=disable

# 或者使用完整 DSN（设置后会覆盖上面的独立参数）
# POSTGRES_DSN=host=localhost port=5432 user=postgres password=postgres dbname=export_service sslmode=disable

# 导出文件存储目录（默认为 ./exports）
EXPORT_STORAGE_DIR=./exports
